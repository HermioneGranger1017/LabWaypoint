spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/lab_equipment
    username: root
    password: ${DB_PASSWORD}
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB

upload:
  path: ${UPLOAD_PATH:./uploads/}

jwt:
  secret: ${JWT_SECRET}

mybatis:
  configuration:
    map-underscore-to-camel-case: true
